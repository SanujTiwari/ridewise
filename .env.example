# RideWise Production Environment Configuration Example
PROJECT_NAME="RideWise API"
VERSION="1.0.0"

# Secret key for JWT access tokens
JWT_SECRET="ridewise_super_secret_jwt_key_2026_change_in_production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# PostgreSQL Database Connection URL
DATABASE_URL="postgresql://ridewise_user:ridewise_password@localhost:5432/ridewise_db"

# Redis Cache Connection URL
REDIS_URL="redis://localhost:6379/0"

# Frontend Origin for CORS
CORS_ORIGIN="http://localhost:5173"
